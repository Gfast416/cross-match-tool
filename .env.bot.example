# Arbitrage Bot — Environment Configuration
# Copy to .env (or .env.bot) and fill in. NEVER commit secrets to git!
# Bot default = dry-run (no real funds move). Set MODE=live only after testing.

# --- Mode ---
# dry-run = simulate only (safe). live = build real tx via Meteora SDK (needs keys below)
MODE=dry-run

# --- Trade sizing & filters ---
TRADE_AMOUNT_SOL=0.5          # size per trade (SOL)
MIN_TVL=100                   # min pool TVL (USD) for scanner
MIN_MISPRICING=0.5            # min cross-venue mispricing % to flag a candidate
MIN_PROFIT_PCT=1.0            # min NET profit % before acting
ADD_CLOSE_LEG=false           # true = also close USDC->SOL via Jupiter (matches screenshot). false = stop at USDC
SCAN_INTERVAL_MS=30000        # scan loop interval
MAX_PAGES=3                   # Meteora API pages per venue (500/page). raise for deeper scans

# --- LIVE mode only (leave blank in dry-run) ---
# WALLET_PRIVATE_KEY = base64-encoded JSON secret key array
# RPC_URL = https://your-solana-rpc-endpoint

# --- Optional Telegram alerts ---
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=987654321
